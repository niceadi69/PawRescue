# Copy this file to web/.env and fill in both values from
# Supabase -> Project Settings -> API.
# Use the anon (or "publishable") key. NEVER the service-role/secret key:
# everything in the web app is visible to anyone who opens it.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
